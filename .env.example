# Copy to .env and adjust. Never commit .env.

# --- Database / cache ---
POSTGRES_USER=careledger
POSTGRES_PASSWORD=careledger
POSTGRES_DB=careledger
# Used when running the backend outside Docker (make dev-api / tests):
DATABASE_URL=postgresql+psycopg://careledger:careledger@localhost:5432/careledger
REDIS_URL=redis://localhost:6379/0

# --- Auth ---
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-secret-change-me-please
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# --- Demo ---
# Every seeded demo user shares this password (see docs/DEMO_USERS.md). Re-run `make seed` after changing.
DEMO_PASSWORD=CareLedger!2026

# --- Approval thresholds (money as decimal strings) ---
MANUAL_JOURNAL_APPROVAL_THRESHOLD=10000.00
REFUND_APPROVAL_THRESHOLD=500.00

# --- Logging ---
LOG_LEVEL=INFO
LOG_JSON=false

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_CURRENCY=USD
